# Copy to .env; never commit the resulting .env file.
MODE=demo
DATABASE_URL=sqlite:///./paper.db
INITIAL_CAPITAL=100000
SYMBOLS=BTCUSDT,ETHUSDT
STRATEGY_WINDOW=20
ENTRY_Z=1.8
EXIT_Z=0.5
FEE_RATE=0.0004
SLIPPAGE_BPS=2
ORDER_NOTIONAL=1000
MIN_NOTIONAL=10
MAX_POSITION_BTC=0.5
MAX_POSITION_ETH=5
MAX_DAILY_LOSS=2000
STALE_DATA_TIMEOUT_MS=5000
# Supply a long random secret for mutating controls; never use this placeholder in production.
CONTROL_TOKEN=replace-with-long-random-secret
POSTGRES_PASSWORD=replace-with-long-random-secret
